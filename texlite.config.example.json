{
  "siteName": "TexLite",
  "adminEmail": "admin@example.com",
  "sessionDays": 14,
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "basePath": "/"
  },
  "uploads": {
    "maxFileSizeMB": 50
  },
  "pdf": {
    "loadingStrategy": "auto",
    "rangeThresholdMB": 5
  },
  "history": {
    "maxVersions": 0,
    "maxStorageMB": 128
  },
  "editHistory": {
    "maxStorageMB": 32
  },
  "githubOAuth": {
    "clientId": "",
    "clientSecret": "",
    "redirectUri": "http://localhost:3001/auth/github/callback"
  },
  "latex": {
    "latexmk": "latexmk",
    "defaultEngine": "xelatex",
    "allowedEngines": ["pdflatex", "xelatex", "lualatex"],
    "extraArgs": [],
    "compileTimeoutSeconds": 120,
    "maxCompileJobs": 10
  }
}
