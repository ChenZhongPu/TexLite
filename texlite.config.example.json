{
  "siteName": "TexLite",
  "adminEmail": "admin@example.com",
  "sessionDays": 7,
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "basePath": "/",
    "trustedProxyIps": ["127.0.0.1", "::1"]
  },
  "storage": {
    "dataDir": "./data"
  },
  "database": {
    "driver": "postgresql",
    "url": "postgresql://postgres:CHANGE_ME@127.0.0.1:5432/texlite-demo",
    "sslMode": "disable"
  },
  "uploads": {
    "maxFileSizeMB": 50
  },
  "pdf": {
    "loadingStrategy": "auto",
    "rangeThresholdMB": 5
  },
  "history": {
    "maxVersions": 0,
    "maxStorageMB": 64
  },
  "editHistory": {
    "maxStorageMB": 32
  },
  "projects": {
    "maxProjectsPerUser": 100,
    "maxSourceStorageMBPerUser": 2048
  },
  "ai": {
    "baseURL": "http://127.0.0.1:4010",
    "apiKey": "replace-with-ai-server-api-key"
  },
  "OAuth": {
    "baseURL": "https://testagent.xspaceagi.com",
    "clientId": "",
    "clientSecret": "",
    "redirectUri": ""
  },
  "latex": {
    "latexmk": "latexmk",
    "defaultEngine": "xelatex",
    "allowedEngines": ["pdflatex", "xelatex", "lualatex"],
    "extraArgs": [],
    "compileTimeoutSeconds": 120,
    "maxCompileJobs": 10
  }
}
