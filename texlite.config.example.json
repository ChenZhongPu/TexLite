{
  "siteName": "TexLite",
  "adminEmail": "admin@example.com",
  "sessionDays": 7,
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "basePath": "/",
    "trustedProxyIps": ["127.0.0.1", "::1"]
  },
  "uploads": {
    "maxFileSizeMB": 50
  },
  "pdf": {
    "loadingStrategy": "auto",
    "rangeThresholdMB": 5
  },
  "history": {
    "maxVersions": 0,
    "maxStorageMB": 64
  },
  "editHistory": {
    "maxStorageMB": 32
  },
  "projects": {
    "maxProjectsPerUser": 100,
    "maxSourceStorageMBPerUser": 2048
  },
  "githubOAuth": {
    "clientId": "",
    "clientSecret": "",
    "redirectUri": ""
  },
  "latex": {
    "latexmk": "latexmk",
    "defaultEngine": "xelatex",
    "allowedEngines": ["pdflatex", "xelatex", "lualatex"],
    "extraArgs": [],
    "compileTimeoutSeconds": 120,
    "maxCompileJobs": 10
  }
}
